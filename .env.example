# Required at BUILD time (inlined into the client bundle by Vite).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Required at RUNTIME on the server (used by SSR / server functions).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Port the Node server listens on. Railway sets this automatically.
PORT=3000